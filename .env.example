# From https://developers.kite.trade/ — create an app and set redirect URL to:
#   ${APP_URL}/api/auth/callback
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# Random string, at least 32 characters (used to encrypt session cookie)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Public URL where this app runs (no trailing slash). Required locally; optional on Vercel.
APP_URL=http://localhost:4321

# Arhatic Yoga practice log (/practice)
# Optional shared code. Leave blank to keep the log open on a private network.
PRACTICE_ACCESS_CODE=

# Weekly summary recipients, comma-separated.
PRACTICE_MAIL_TO=
PRACTICE_MAIL_FROM=

# Gmail: host smtp.gmail.com, port 587, and an app password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Or use Resend instead of SMTP. PRACTICE_MAIL_FROM must be a verified sender.
RESEND_API_KEY=

# Protects the Monday cron at /api/practices/weekly. Vercel sends this automatically.
CRON_SECRET=
